<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- No INTERNET: jLock is fully offline. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Fingerprint unlock, via the system BiometricPrompt. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Touch feedback on the lock screen keys. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Lets the user lift battery restrictions so the lock keeps running. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Post the masked notifications that replace locked apps' own. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Usage-Access engine (optional, user-selected): read the foreground app without accessibility,
         so banking apps that refuse accessibility still run. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Lets the usage-access service raise the lock screen over a locked app from the background. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- The usage-access watcher runs as a foreground service; restart it after reboot. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Transparent host that shows BiometricPrompt over a locked app (the overlay/service can't
             show it directly). Finishes the moment it has a result; kept out of Recents and history. -->
        <activity
            android:name=".BiometricProxyActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|density|uiMode" />

        <!-- Usage-Access engine lock screen: a full-screen Activity shown over a locked app (no accessibility). -->
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:screenOrientation="portrait"
            android:theme="@style/LockActivityTheme"
            android:resizeableActivity="false"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|density|uiMode" />

        <!-- Usage-Access engine watcher: a foreground service that detects the foreground app via Usage Access. -->
        <!-- Direct-boot aware: started right at boot, it waits for the first unlock and is ready the moment it comes. -->
        <service
            android:name=".UsageAccessLockService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="App lock: detects the foreground app to show the lock over locked apps." />
        </service>

        <!-- Restart the usage-access watcher after reboot / app update. Direct-boot aware, so it hears the early
             LOCKED_BOOT_COMPLETED: BOOT_COMPLETED can reach an app a minute or more after the phone is unlocked. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The accessibility lock engine: event-driven foreground detection + overlay, no polling. -->
        <service
            android:name=".JLockAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Notification privacy: replaces a locked app's notifications with a masked "Unlock to view."
             while keeping its sound/vibration. Metadata is processed in RAM only, never stored or sent. -->
        <service
            android:name=".JLockNotificationListener"
            android:exported="false"
            android:label="@string/notification_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
